        "schoolId": { "type": "string" },
        "attendanceId": { "type": "string" },
        "date": { "type": "string" },
        "originalStatus": { "type": "string" },
        "requestedStatus": { "type": "string" },
        "reason": { "type": "string" },
        "requestedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
