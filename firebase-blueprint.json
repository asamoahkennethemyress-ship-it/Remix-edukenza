      },
      "required": ["id", "schoolId", "date", "originalStatus", "requestedStatus", "reason", "requestedBy", "status"]
    },
    "userCreatedContent": {
      "title": "User Created Content",
      "description": "User-owned content items including voice notes, AI resources, study notes, drafts, and documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "ownerRole": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "targetClass": { "type": "string" },
        "isShared": { "type": "boolean" },
        "shareScope": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "createdBy", "title", "content", "type"]
    }
  },
  "firestore": {
    "/userCreatedContent/{contentId}": {
      "schema": { "$ref": "#/entities/userCreatedContent" },
      "description": "User-owned educational content, notes, voice dictations, and AI resources"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User documents keyed by Auth UID"
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/schools" },
      "description": "School documents keyed by schoolId"
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/platformSettings" },
      "description": "Global settings accessible only by platform_owner"
    },
    "/subscriptionPlans/{planId}": {
      "schema": { "$ref": "#/entities/subscriptionPlans" },
      "description": "Subscription plans created by platform_owner"
    },
    "/pricingPlans/{planId}": {
      "schema": { "$ref": "#/entities/pricingPlans" },
      "description": "Dynamic pricing plans created by platform_owner for marketing site"
    },
    "/schoolSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/schoolSubscriptions" },
      "description": "School subscription records"
    },
    "/billingInvoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/billingInvoices" },
      "description": "Platform SaaS subscription invoices"
    },
