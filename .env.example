# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ============================================================
# PAYSTACK PAYMENT GATEWAY CONFIGURATION (EDUkenZA OFFICIAL)
# ============================================================
# PAYSTACK_SECRET_KEY: Server-side secret key for initializing & verifying transactions.
# MUST NEVER be exposed to the browser or client-side bundles.
PAYSTACK_SECRET_KEY=

# PAYSTACK_PUBLIC_KEY: Public key used client-side for Paystack inline checkout popup.
PAYSTACK_PUBLIC_KEY=

# ============================================================
# FIREBASE PROJECT CONFIGURATION (Vercel & Production)
# Target Project: edukenza-2ab0
# ============================================================
VITE_FIREBASE_PROJECT_ID=edukenza-2ab0
VITE_FIREBASE_AUTH_DOMAIN=edukenza-2ab0.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=edukenza-2ab0.firebasestorage.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=ai-studio-remixedukenza-e7c63526-01e3-4b16-897a-39990509a023
