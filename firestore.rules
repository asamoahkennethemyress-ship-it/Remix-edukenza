rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Security & Identity Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformOwnerEmail() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'anastasiaappiahkwaa@gmail.com' ||
        request.auth.token.email.lower() == 'asamoahkennethemyress@gmail.com' ||
        request.auth.token.email.lower() == 'kennethasamoa@gmail.com'
      );
    }

    function isPlatformOwner() {
      return isPlatformOwnerEmail() || (hasUserProfile() && getUserData().role == 'platform_owner');
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSchoolAdmin(schoolId) {
      return isPlatformOwnerEmail() || (
        isSignedIn() && schoolId != null && schoolId != '' && (
          (
            hasUserProfile() &&
            (
              getUserData().schoolId == schoolId ||
              getUserData().school_id == schoolId
            ) &&
            (
              getUserData().role == 'school_admin' ||
              getUserData().role == 'school admin' ||
              getUserData().role == 'schoolAdmin' ||
              getUserData().role == 'school_head' ||
              getUserData().role == 'assistant_academics' ||
              getUserData().role == 'assistant_domestic'
            )
          ) ||
          (
            request.auth.token.email != null &&
            exists(/databases/$(database)/documents/schools/$(schoolId)) &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.adminEmail != null &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.adminEmail.lower() == request.auth.token.email.lower()
          )
        )
      );
    }

    function isDomesticStaff(schoolId) {
      return isPlatformOwnerEmail() || (
        isSignedIn() && schoolId != null && schoolId != '' && (
          isSchoolAdmin(schoolId) || (
            hasUserProfile() &&
            (getUserData().schoolId == schoolId || getUserData().school_id == schoolId) &&
            (
              getUserData().role == 'house_master' ||
              getUserData().role == 'housemaster' ||
              getUserData().role == 'housekeeping' ||
              getUserData().role == 'facilities' ||
              getUserData().role == 'general_services'
            )
          )
        )
      );
    }

    function isSchoolMember(schoolId) {
      return isPlatformOwnerEmail() || (
        isSignedIn() && schoolId != null && schoolId != '' && (
          isSchoolAdmin(schoolId) ||
          (
            hasUserProfile() &&
            (
              getUserData().schoolId == schoolId ||
              getUserData().school_id == schoolId
            )
          )
        )
      );
    }

    function isSchoolTeacher(schoolId) {
      return isPlatformOwnerEmail() || (
        isSignedIn() && schoolId != null && schoolId != '' && (
          isSchoolAdmin(schoolId) ||
          (
            hasUserProfile() &&
            (
              getUserData().schoolId == schoolId ||
              getUserData().school_id == schoolId
            ) &&
            (
              getUserData().role == 'teacher' ||
              getUserData().role == 'school_admin'
            )
          )
        )
      );
    }

    function isParentOfStudent(studentDocId) {
      return isPlatformOwnerEmail() || (
        isSignedIn() && hasUserProfile() && (
          getUserData().role == 'parent' && (
            (getUserData().studentId != null && getUserData().studentId == studentDocId) ||
            exists(/databases/$(database)/documents/parentStudentRelations/$(request.auth.uid + '_' + studentDocId)) ||
            exists(/databases/$(database)/documents/parentStudentRelations/$(studentDocId + '_' + request.auth.uid))
          )
        )
      );
    }

    // Public Marketing, Plans, and System Configuration
    match /marketing_site/{docId} {
      allow read: if true;
      allow write: if isPlatformOwnerEmail();
    }

    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if isPlatformOwnerEmail();
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isPlatformOwnerEmail();
    }

    // Schools Directory and Registration
    match /schools/{schoolId} {
      allow get: if isPlatformOwnerEmail() || 
        (isSignedIn() && resource.data.adminId != null && request.auth.uid == resource.data.adminId) ||
        (isSignedIn() && resource.data.adminEmail != null && request.auth.token.email != null && resource.data.adminEmail.lower() == request.auth.token.email.lower()) ||
        isSchoolMember(schoolId);
      allow list: if isPlatformOwnerEmail() ||
        (isSignedIn() && request.auth.token.email != null && (resource.data.adminEmail == request.auth.token.email || resource.data.adminEmail == request.auth.token.email.lower())) ||
        isSchoolMember(schoolId);
      allow create: if isSignedIn(); // Allows new school admin self-registration
      allow update: if (isSignedIn() && resource.data.adminId != null && request.auth.uid == resource.data.adminId) ||
        isSchoolAdmin(schoolId) || 
        isPlatformOwnerEmail() || 
        (isSignedIn() && resource.data.adminEmail != null && request.auth.token.email != null && resource.data.adminEmail.lower() == request.auth.token.email.lower());
      allow delete: if isPlatformOwnerEmail();
    }

    // Core User Identity Documents (users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformOwnerEmail() ||
        (hasUserProfile() && getUserData().role == 'platform_owner') ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) ||
        (resource.data.schoolId != null && isSchoolTeacher(resource.data.schoolId)) ||
        isParentOfStudent(userId) ||
        (resource.data.email != null && request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()))
      );
      allow list: if isSignedIn() && (
        isPlatformOwnerEmail() ||
        (hasUserProfile() && getUserData().role == 'platform_owner') ||
        (request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (request.resource.data.role != 'platform_owner' || isPlatformOwnerEmail())) || 
        isPlatformOwnerEmail() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId))
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformOwnerEmail() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow delete: if isPlatformOwnerEmail() || 
        (isSignedIn() && resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) ||
        (isSignedIn() && resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower());
    }

    // Sub-role profiles with strict school isolation
    match /schoolAdmins/{adminId} {
      allow get: if isSignedIn() && (
        request.auth.uid == adminId ||
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        isPlatformOwnerEmail() || 
        (resource.data.adminEmail != null && request.auth.token.email != null && resource.data.adminEmail.lower() == request.auth.token.email.lower()) ||
        isSchoolAdmin(resource.data.schoolId)
      );
      allow list: if isSignedIn() && (
        isPlatformOwnerEmail() ||
        (request.auth.token.email != null && (resource.data.adminEmail == request.auth.token.email || resource.data.adminEmail == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isSignedIn(); // Allows new school admin self-registration
      allow update: if isSignedIn() && (
        request.auth.uid == adminId ||
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        isPlatformOwnerEmail() || 
        isSchoolAdmin(resource.data.schoolId) || 
        (resource.data.adminEmail != null && request.auth.token.email != null && resource.data.adminEmail.lower() == request.auth.token.email.lower())
      );
      allow delete: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(resource.data.schoolId));
    }

    match /teachers/{teacherId} {
      allow get: if isSignedIn() && (
        request.auth.uid == teacherId ||
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        isPlatformOwnerEmail() || 
        (resource.data.email != null && request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && (isSchoolAdmin(resource.data.schoolId) || isSchoolTeacher(resource.data.schoolId)))
      );
      allow list: if isSignedIn() && (
        isPlatformOwnerEmail() ||
        (request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) ||
        (resource.data.schoolId != null && isSchoolTeacher(resource.data.schoolId))
      );
      allow create: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isSignedIn() && (
        isPlatformOwnerEmail() || 
        isSchoolAdmin(resource.data.schoolId) || 
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        (
          request.auth.token.email != null &&
          resource.data.email != null &&
          (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()) &&
          request.resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(resource.data.schoolId));
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && (
        request.auth.uid == studentId ||
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        isPlatformOwnerEmail() || 
        (resource.data.email != null && request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
        (resource.data.googleEmail != null && request.auth.token.email != null && (resource.data.googleEmail == request.auth.token.email || resource.data.googleEmail.lower() == request.auth.token.email.lower())) ||
        isParentOfStudent(studentId) ||
        (resource.data.schoolId != null && (isSchoolAdmin(resource.data.schoolId) || isSchoolTeacher(resource.data.schoolId)))
      );
      allow list: if isSignedIn() && (
        isPlatformOwnerEmail() ||
        (request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower())) ||
        (request.auth.token.email != null && (resource.data.googleEmail == request.auth.token.email || resource.data.googleEmail == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) ||
        (resource.data.schoolId != null && isSchoolTeacher(resource.data.schoolId))
      );
      allow create: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isSignedIn() && (
        isPlatformOwnerEmail() || 
        isSchoolAdmin(resource.data.schoolId) || 
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        (
          request.auth.token.email != null &&
          (
            (resource.data.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
            (resource.data.googleEmail != null && (resource.data.googleEmail == request.auth.token.email || resource.data.googleEmail == request.auth.token.email.lower()))
          ) &&
          request.resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(resource.data.schoolId));
    }

    match /parents/{parentId} {
      allow get: if isSignedIn() && (
        request.auth.uid == parentId ||
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        isPlatformOwnerEmail() || 
        (resource.data.email != null && request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow list: if isSignedIn() && (
        isPlatformOwnerEmail() ||
        (request.auth.token.email != null && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower())) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isSignedIn() && (
        isPlatformOwnerEmail() || 
        isSchoolAdmin(resource.data.schoolId) || 
        (resource.data.uid != null && request.auth.uid == resource.data.uid) ||
        (
          request.auth.token.email != null &&
          resource.data.email != null &&
          (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()) &&
          request.resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isSignedIn() && (isPlatformOwnerEmail() || isSchoolAdmin(resource.data.schoolId));
    }

    match /parentStudentRelations/{relationId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) ||
        resource.data.parentUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolAdmin(resource.data.schoolId));
      allow delete: if isSignedIn() && (isPlatformOwner() || isSchoolAdmin(resource.data.schoolId));
    }

    // LMS & Educational Modules with School Isolation
    match /libraryResources/{resourceId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (
          isSchoolMember(resource.data.schoolId) && (
            isSchoolTeacher(resource.data.schoolId) ||
            (
              resource.data.status == 'published' &&
              (resource.data.targetAudience == null || resource.data.targetAudience == 'all' || 
               (hasUserProfile() && getUserData().role == 'student' && (resource.data.targetAudience == 'students' || resource.data.targetAudience == 'all')) ||
               (hasUserProfile() && getUserData().role == 'parent' && (resource.data.targetAudience == 'parents' || resource.data.targetAudience == 'all')))
            )
          )
        )
      );
      allow create: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(request.resource.data.schoolId)
      );
      allow update: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolAdmin(resource.data.schoolId) ||
        (isSchoolTeacher(resource.data.schoolId) && (resource.data.uploaderId == request.auth.uid || request.auth.uid != null))
      );
      allow delete: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolAdmin(resource.data.schoolId) ||
        (isSchoolTeacher(resource.data.schoolId) && resource.data.uploaderId == request.auth.uid)
      );
    }

    match /libraryBookmarks/{bookmarkId} {
      allow read: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update, delete: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
    }

    match /libraryRecentlyViewed/{historyId} {
      allow read: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update, delete: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
    }

    match /libraryProgress/{progressId} {
      allow read: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (isPlatformOwner() || resource.data.userId == request.auth.uid);
    }

    match /borrowRecords/{recordId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /libraryBorrowRecords/{recordId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /libraryDiscussions/{discussionId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /libraryReviews/{reviewId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsCourses/{courseId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsLessons/{lessonId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsMaterials/{matId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsQuizzes/{quizId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsQuizAttempts/{attemptId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId));
      allow delete: if isPlatformOwner();
    }

    match /lmsSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId) || resource.data.studentId == request.auth.uid);
      allow delete: if isPlatformOwner();
    }

    match /lmsDiscussions/{discussionId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /lmsProgress/{progressId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create, update: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolMember(request.resource.data.schoolId)
      );
      allow delete: if isPlatformOwner() || isSchoolAdmin(resource.data.schoolId);
    }

    // CBT & Examinations
    match /cbtQuestions/{questionId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /cbtExams/{examId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /cbtResults/{resultId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId));
      allow delete: if isPlatformOwner();
    }

    match /cbtAttempts/{attemptId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId));
      allow delete: if isPlatformOwner();
    }

    match /cbtCertificates/{certId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    // Academic Administration, Assignments & Grades (Strict Isolation)
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /assignmentSubmissions/{subId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId) || resource.data.studentId == request.auth.uid);
      allow delete: if isPlatformOwner();
    }

    match /submissions/{subId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId));
      allow update: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(resource.data.schoolId) || resource.data.studentId == request.auth.uid);
      allow delete: if isPlatformOwner();
    }

    match /assignmentComments/{commentId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /examinations/{examId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /marks/{markId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
        resource.data.studentId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /results/{resultId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolTeacher(resource.data.schoolId) || 
