      );
      allow delete: if false; // Prevent payment deletion
    }

    match /paymentReceipts/{receiptId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) || 
        resource.data.userId == request.auth.uid || 
        resource.data.studentId == request.auth.uid || 
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolMember(request.resource.data.schoolId))
      );
      allow update, delete: if false; // IMMUTABLE RECEIPTS
    }

    match /schoolFees/{feeId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isPlatformOwner() || (isSignedIn() && isSchoolAdmin(resource.data.schoolId || request.resource.data.schoolId));
    }

    match /paymentMethods/{methodId} {
      allow read: if isSignedIn();
      allow write: if isPlatformOwner();
    }

    match /schoolSubscriptions/{subId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolMember(resource.data.schoolId))
      );
      allow write: if isPlatformOwner();
    }

    // Biometric Credentials & Audit Logs (Multi-tenant secured)
    match /biometricDevices/{devId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolMember(resource.data.schoolId))
      );
      allow write: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId)) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
    }

    match /biometric_devices/{devId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolMember(resource.data.schoolId))
      );
      allow write: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId)) ||
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId))
      );
    }

    match /biometricCredentials/{credId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) || 
        resource.data.userId == request.auth.uid || 
        request.auth.uid == credId
      );
      allow write: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId)) || 
        request.auth.uid == credId || 
        request.resource.data.userId == request.auth.uid
      );
    }

    match /biometric_credentials/{credId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) || 
        resource.data.userId == request.auth.uid || 
        request.auth.uid == credId
      );
      allow write: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId)) || 
        request.auth.uid == credId || 
        request.resource.data.userId == request.auth.uid
      );
    }

    match /biometric_enrolments/{credId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)) || 
        resource.data.userId == request.auth.uid || 
        request.auth.uid == credId
      );
      allow write: if isSignedIn() && (
        isPlatformOwner() || 
        (request.resource.data.schoolId != null && isSchoolAdmin(request.resource.data.schoolId)) || 
        request.auth.uid == credId || 
        request.resource.data.userId == request.auth.uid
      );
    }

    match /biometricAuditLogs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /biometric_audit_logs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /biometric_logs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    match /financeAuditLogs/{logId} {
      allow read: if isSignedIn() && (isPlatformOwner() || (resource.data.schoolId != null && isSchoolAdmin(resource.data.schoolId)));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /mealPreOrders/{orderId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolMember(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /googleMeetRecordings/{recId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isSchoolTeacher(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /backupHistory/{backupId} {
      allow read, write: if isPlatformOwner();
    }

    match /restoreHistory/{restoreId} {
      allow read, write: if isPlatformOwner();
    }

    match /importHistory/{id} {
      allow read, write: if isSignedIn() && (isPlatformOwner() || isSchoolAdmin(resource.data.schoolId || request.resource.data.schoolId));
    }

    match /exportHistory/{id} {
      allow read, write: if isSignedIn() && (isPlatformOwner() || isSchoolAdmin(resource.data.schoolId || request.resource.data.schoolId));
    }

    match /backups/{backupId} {
      allow read, write: if isPlatformOwner();
    }

    match /restoreLogs/{restoreId} {
      allow read, write: if isPlatformOwner();
    }

    // Senior High Boarding & Domestic Operations
    match /boardingHouses/{houseId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isDomesticStaff(request.resource.data.schoolId || resource.data.schoolId));
    }

    match /exeatRequests/{exeatId} {
      allow read: if isSignedIn() && (
        isPlatformOwner() || 
        isDomesticStaff(resource.data.schoolId) ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email ||
        isParentOfStudent(resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        isPlatformOwner() || 
        isDomesticStaff(request.resource.data.schoolId) ||
        request.resource.data.studentId == request.auth.uid ||
        isParentOfStudent(request.resource.data.studentId)
      );
      allow update: if isSignedIn() && (
        isPlatformOwner() || 
        isDomesticStaff(resource.data.schoolId)
      );
      allow delete: if isSignedIn() && (
        isPlatformOwner() || 
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    match /maintenanceWorkOrders/{orderId} {
      allow read: if isSignedIn() && (isPlatformOwner() || isSchoolMember(resource.data.schoolId));
      allow write: if isSignedIn() && (isPlatformOwner() || isDomesticStaff(request.resource.data.schoolId || resource.data.schoolId));
    }

    // Default catch-all: Deny all unauthenticated or unhandled access
    match /{document=**} {
      allow read, write: if isPlatformOwner();
    }
  }
}
